// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand(a=a , b=b , out=x1 );
    Nand(a=a , b=x1 , out=x2 );
    Nand(a=b , b=x1 , out=x3);
    Nand(a=x2 , b=x3 , out=out);
}